RewriteEngine On
RewriteBase /weng/me/
DirectoryIndex index.html

# Legacy React SPA paths → new static IA
RewriteRule ^whoami/?$ /weng/me/about/ [R=302,L]
RewriteRule ^work/?$ /weng/me/projects/ [R=302,L]
RewriteRule ^tech/?$ /weng/me/about/ [R=302,L]
RewriteRule ^resume/?$ /weng/me/about/ [R=302,L]
RewriteRule ^testimonials/?$ /weng/me/#testimonials [R=302,NE,L]
RewriteRule ^students/?$ /weng/me/#testimonials [R=302,NE,L]
RewriteRule ^collab/?$ /weng/me/projects/ [R=302,L]
RewriteRule ^credited/?$ /weng/me/projects/ [R=302,L]
RewriteRule ^certs/?$ /weng/me/about/ [R=302,L]
RewriteRule ^certificates/?$ /weng/me/about/ [R=302,L]
RewriteRule ^achievements/?$ /weng/me/about/ [R=302,L]
